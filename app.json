{
  "expo": {
    "name": "Lenvy",
    "slug": "lenvy",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/lenvy-brand-assets/png/icon-expo-1024.png",
    "scheme": "lenvy",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F4F2EE",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "app.lenvy.mobile"
    },
    "android": {
      "package": "app.lenvy.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#1E4D3B",
        "foregroundImage": "./assets/lenvy-brand-assets/png/android-adaptive-foreground.png",
        "backgroundImage": "./assets/lenvy-brand-assets/png/android-adaptive-background.png",
        "monochromeImage": "./assets/lenvy-brand-assets/png/android-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/lenvy-brand-assets/png/favicon-48.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1E4D3B",
          "image": "./assets/lenvy-brand-assets/png/splash-icon.png",
          "imageWidth": 96,
          "dark": {
            "backgroundColor": "#0A0D12"
          }
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Lenvy uses the camera to scan receipts.",
          "photosPermission": "Lenvy reads receipt photos from your library to log a transaction."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Lenvy uses the camera to scan receipts."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Lenvy records your voice note and turns it into a transaction draft."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "6b6ea20d-af9f-4445-922f-3c3b0eb807c5"
      }
    },
    "owner": "batman_007"
  }
}
